{
    "info": {
        "name": "Cosmetics E-commerce API",
        "description": "Complete API collection for Cosmetics E-commerce platform",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000/api",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Admin Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const response = pm.response.json();",
                                    "    if (response.success && response.data.token) {",
                                    "        pm.collectionVariables.set('token', response.data.token);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@admin.com\",\n    \"password\": \"mans123456\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/public/auth/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "auth", "login"]
                        }
                    }
                },
                {
                    "name": "Get Current User",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/auth/user",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "auth", "user"]
                        }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/public/auth/logout",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "auth", "logout"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Public Products",
            "item": [
                {
                    "name": "Get All Products",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/products?per_page=12&sort_by=created_at&sort_order=desc",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "products"],
                            "query": [
                                {
                                    "key": "per_page",
                                    "value": "12"
                                },
                                {
                                    "key": "sort_by",
                                    "value": "created_at"
                                },
                                {
                                    "key": "sort_order",
                                    "value": "desc"
                                },
                                {
                                    "key": "search",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "brand",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "type",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "gender",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "in_stock",
                                    "value": "true",
                                    "disabled": true
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Single Product",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/products/6",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "products", "6"]
                        }
                    }
                },
                {
                    "name": "Check Product Availability",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"quantity\": 5\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/public/products/6/availability",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "products", "6", "availability"]
                        }
                    }
                },
                {
                    "name": "Get Product Stock",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/products/6/stock",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "products", "6", "stock"]
                        }
                    }
                },
                {
                    "name": "Search Products",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/products-search?q=lipstick&limit=10",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "products-search"],
                            "query": [
                                {
                                    "key": "q",
                                    "value": "lipstick"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Featured Products",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/products-featured?limit=8",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "products-featured"],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "8"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Filter Options",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/products-filters",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "products-filters"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Public Orders",
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"client\": {\n        \"name\": \"John Doe\",\n        \"email\": \"john@example.com\",\n        \"phone\": \"+1234567890\",\n        \"address\": \"123 Main St\",\n        \"city\": \"New York\"\n    },\n    \"items\": [\n        {\n            \"product_id\": 6,\n            \"quantity\": 2\n        },\n        {\n            \"product_id\": 10,\n            \"quantity\": 1\n        }\n    ],\n    \"notes\": \"Please handle with care\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/public/orders",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "orders"]
                        }
                    }
                },
                {
                    "name": "Get Order Details",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/orders/1",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "orders", "1"]
                        }
                    }
                },
                {
                    "name": "Track Orders by Email",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/public/orders-track?email=john@example.com",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "orders-track"],
                            "query": [
                                {
                                    "key": "email",
                                    "value": "john@example.com"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Validate Cart",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"items\": [\n        {\n            \"product_id\": 6,\n            \"quantity\": 2\n        },\n        {\n            \"product_id\": 10,\n            \"quantity\": 1\n        }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/public/orders-validate-cart",
                            "host": ["{{baseUrl}}"],
                            "path": ["public", "orders-validate-cart"]
                        }
                    }
                }
            ]
        },
